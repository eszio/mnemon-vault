#!/usr/bin/env bash
# mnemon-vault — cross-device, cross-team memory sync for mnemon
# Uses age encryption with SSH public keys fetched from your git host.
# Per-device files guarantee zero git conflicts.
set -euo pipefail

SYNC_DIR="${MNEMON_VAULT_DIR:-$HOME/.mnemon-vault}"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/mnemon-vault/config"
IDENTITY_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/mnemon-vault/identity.txt"
DB_TEAM="${MNEMON_DB_TEAM:-$HOME/.mnemon/data/team/mnemon.db}"
DB_PERSONAL="${MNEMON_DB_PERSONAL:-$HOME/.mnemon/data/personal/mnemon.db}"
DEVICE="$(hostname -s)-$(id -un)"

# Load per-machine config (GIT_HOST_USER, GIT_HOST_URL)
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi
GIT_HOST_URL="${GIT_HOST_URL:-}"
GIT_HOST_USER="${GIT_HOST_USER:-}"

# This script runs from Claude Code SessionStart/SessionEnd hooks, which have
# no TTY and get cancelled if they hang. Every network call must fail fast:
# curl gets hard timeouts, and ssh must error out instead of prompting.
CURL_OPTS=(-sf --connect-timeout 5 --max-time 15)
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=10}"

# Public template repo and the tooling files `update` pulls from it.
# Roster (members.txt) and data/ are never touched by an update.
UPSTREAM_URL="${UPSTREAM_URL:-https://github.com/eszio/mnemon-vault.git}"
TOOLING_FILES=(mnemon-vault install.sh guide.md members.txt.example README.md CONTRIBUTING.md)

# ── helpers ──────────────────────────────────────────────────────────

_require_age() {
    if ! command -v age &>/dev/null; then
        echo "[mnemon-vault] ERROR: 'age' not found. Install: sudo apt install age" >&2
        exit 1
    fi
}

_require_config() {
    local missing=()
    [ -z "$GIT_HOST_USER" ] && missing+=("GIT_HOST_USER")
    [ -z "$GIT_HOST_URL" ]  && missing+=("GIT_HOST_URL")
    if [ ${#missing[@]} -gt 0 ]; then
        echo "[mnemon-vault] ERROR: ${missing[*]} not set. Run: mnemon-vault configure" >&2
        exit 1
    fi
}

_fetch_keys() {
    local user="$1"
    local keys usable recipients_file recipients_lines combined

    # Source (a): age-compatible ssh keys from the git host
    keys=$(curl "${CURL_OPTS[@]}" "${GIT_HOST_URL}/${user}.keys" 2>/dev/null) || {
        echo "[mnemon-vault] WARNING: could not fetch keys for ${user}" >&2
        keys=""
    }
    # age accepts only ssh-ed25519 and ssh-rsa recipients. Drop anything else
    # (ecdsa, sk-*, dss) so one member's unsupported key can't break the whole push.
    usable=$(printf '%s\n' "$keys" | grep -E '^(ssh-ed25519|ssh-rsa) ' || true)

    # Source (b): age recipients from $SYNC_DIR/recipients/<user>.txt
    recipients_file="$SYNC_DIR/recipients/${user}.txt"
    recipients_lines=""
    if [ -f "$recipients_file" ]; then
        # Accept only native age recipients (age1…) so one member's bad line can't break the whole push.
        recipients_lines=$(grep -E '^age1' "$recipients_file" || true)
    fi

    combined=""
    [ -n "$usable" ] && combined="$usable"
    if [ -n "$recipients_lines" ]; then
        if [ -n "$combined" ]; then
            combined="${combined}
${recipients_lines}"
        else
            combined="$recipients_lines"
        fi
    fi

    if [ -z "$combined" ]; then
        echo "[mnemon-vault] WARNING: ${user} has no usable recipient (need an ed25519/rsa key on the git host, or age1 lines in recipients/${user}.txt)" >&2
        return 1
    fi
    echo "$combined"
}

# Probe the git host before any git/curl network work. Off-VPN / offline
# machines must skip networking quickly rather than hang inside a hook.
_online() {
    curl "${CURL_OPTS[@]}" -o /dev/null "${GIT_HOST_URL}/${GIT_HOST_USER}.keys" 2>/dev/null
}

_team_recipients() {
    local members_file="$SYNC_DIR/members.txt"
    if [ ! -f "$members_file" ]; then
        echo "[mnemon-vault] ERROR: members.txt not found in $SYNC_DIR" >&2
        exit 1
    fi
    while IFS= read -r user || [ -n "$user" ]; do
        [[ "$user" =~ ^#|^[[:space:]]*$ ]] && continue
        _fetch_keys "$user" || true
    done < "$members_file"
}

_export_json() {
    local db_path="$1"
    python3 - "$db_path" <<'PYEOF'
import sqlite3, json, sys, os

db_path = sys.argv[1]
if not os.path.exists(db_path):
    print(json.dumps({"schema_version": "1", "insights": []}))
    sys.exit(0)

conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
conn.row_factory = sqlite3.Row

rows = conn.execute("""
    SELECT content, category, importance, tags, entities, source, created_at
    FROM insights
    WHERE deleted_at IS NULL
    ORDER BY created_at
""").fetchall()

insights = []
for row in rows:
    insights.append({
        "content": row["content"],
        "category": row["category"],
        "importance": int(row["importance"]),
        "tags": json.loads(row["tags"] or "[]"),
        "entities": json.loads(row["entities"] or "[]"),
        "source": row["source"],
        "created_at": row["created_at"],
    })

print(json.dumps({"schema_version": "1", "insights": insights}, ensure_ascii=False, indent=2))
conn.close()
PYEOF
}

# ── commands ─────────────────────────────────────────────────────────

cmd_configure() {
    echo "=== mnemon-vault configure ==="

    local prompt_url="${GIT_HOST_URL:-}"
    if [ -n "$prompt_url" ]; then
        printf "Git host URL [%s]: " "$prompt_url"
    else
        printf "Git host URL (e.g. https://github.com): "
    fi
    read -r input_url
    if [ -n "$input_url" ]; then
        GIT_HOST_URL="${input_url%/}"   # strip trailing slash
    elif [ -n "$prompt_url" ]; then
        GIT_HOST_URL="$prompt_url"
    else
        echo "ERROR: Git host URL is required." >&2
        exit 1
    fi

    printf "Your %s username: " "${GIT_HOST_URL#*://}"
    read -r input_user
    [ -z "$input_user" ] && { echo "ERROR: username is required." >&2; exit 1; }
    GIT_HOST_USER="$input_user"

    mkdir -p "$(dirname "$CONFIG_FILE")"
    cat > "$CONFIG_FILE" <<EOF
GIT_HOST_URL=${GIT_HOST_URL}
GIT_HOST_USER=${GIT_HOST_USER}
EOF
    echo "Saved to $CONFIG_FILE"

    # Verify key fetch
    echo "Verifying key fetch..."
    if _fetch_keys "$GIT_HOST_USER" > /dev/null; then
        echo "OK — found SSH keys for ${GIT_HOST_USER}"
    else
        echo "WARNING: Could not fetch keys. Check username and network."
    fi
}

_sha256() {
    # portable: works on Linux and macOS
    echo "$1" | python3 -c "import hashlib,sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())"
}

_push_store() {
    local store="$1" db_path="$2" age_recipients="$3"
    local json hash_file age_file stored_hash current_hash

    mkdir -p "$SYNC_DIR/data/${store}"
    age_file="$SYNC_DIR/data/${store}/insights-${DEVICE}.json.age"
    hash_file="$SYNC_DIR/data/${store}/insights-${DEVICE}.json.sha256"

    json=$(_export_json "$db_path")
    current_hash=$(_sha256 "$json")

    stored_hash=""
    [ -f "$hash_file" ] && stored_hash=$(cat "$hash_file")

    if [ "$current_hash" = "$stored_hash" ]; then
        echo "[mnemon-vault] ${store}: no changes" >&2
        return 1  # 1 = nothing staged
    fi

    echo "$json" | age -R <(echo "$age_recipients") -o "$age_file"
    echo "$current_hash" > "$hash_file"
    git add "data/${store}/insights-${DEVICE}.json.age" \
            "data/${store}/insights-${DEVICE}.json.sha256"
    return 0  # 0 = staged
}

cmd_push() {
    _require_age
    _require_config
    if ! _online; then
        echo "[mnemon-vault] ${GIT_HOST_URL} unreachable — skipping push" >&2
        exit 0
    fi

    cd "$SYNC_DIR"

    # The web URL (load balancer) and the git remote (direct ssh, possibly a
    # different IP) are separate paths — probe the ssh side too. Bounded by
    # GIT_SSH_COMMAND's ConnectTimeout.
    if ! git ls-remote --exit-code origin HEAD >/dev/null 2>&1; then
        echo "[mnemon-vault] git remote unreachable over ssh — skipping push" >&2
        exit 0
    fi

    local changed=0

    # Team store
    local recipients
    recipients=$(_team_recipients)
    if [ -z "$recipients" ]; then
        echo "[mnemon-vault] ERROR: no team recipients found — aborting push" >&2
        exit 1
    fi
    if _push_store "team" "$DB_TEAM" "$recipients"; then changed=1; fi

    # Personal store
    local personal_keys
    personal_keys=$(_fetch_keys "$GIT_HOST_USER" 2>/dev/null) || personal_keys=""
    if [ -n "$personal_keys" ]; then
        if _push_store "personal" "$DB_PERSONAL" "$personal_keys"; then changed=1; fi
    else
        echo "[mnemon-vault] personal: skipping (cannot fetch own keys)" >&2
    fi

    if [ "$changed" -eq 0 ]; then
        # A failed push leaves a committed-but-unpushed state while the hash
        # files already say "no changes" — recover it here.
        if [ -n "$(git log --oneline origin/main..HEAD 2>/dev/null)" ]; then
            echo "[mnemon-vault] pushing commits stranded by an earlier failed push" >&2
            git push origin main --quiet
        else
            echo "[mnemon-vault] nothing to push" >&2
        fi
        return 0
    fi

    # Pull before push to avoid non-fast-forward
    git pull --rebase origin main --quiet 2>&1 | tail -1 >&2 || true
    git commit -m "sync: ${DEVICE} $(date -Iseconds)"
    git push origin main --quiet
    local n
    n=$(python3 -c "
import json,sys,os
f='$SYNC_DIR/data/team/insights-${DEVICE}.json.sha256'
# count via DB not the encrypted file
db='$DB_TEAM'
if not os.path.exists(db): print(0); exit()
import sqlite3
c=sqlite3.connect(f'file:{db}?mode=ro',uri=True)
print(c.execute('SELECT COUNT(*) FROM insights WHERE deleted_at IS NULL').fetchone()[0])
" 2>/dev/null || echo "?")
    echo "[mnemon-vault] pushed (team: ${n} insights, device: ${DEVICE})" >&2
}

_decrypt_with_candidates() {
    # Try each identity candidate in order; stop at first success.
    # Usage: _decrypt_with_candidates <output_tmp> <encrypted_file> <candidate>...
    local out="$1" enc="$2"
    shift 2
    local candidate
    for candidate in "$@"; do
        if age --decrypt -i "$candidate" -o "$out" "$enc" 2>/dev/null; then
            return 0
        fi
    done
    return 1
}

cmd_pull() {
    _require_age
    _require_config

    cd "$SYNC_DIR"
    if _online; then
        git pull --rebase origin main --quiet 2>&1 | tail -1 >&2 || true
    else
        echo "[mnemon-vault] ${GIT_HOST_URL} unreachable — importing local files only" >&2
    fi

    # Build an ordered list of identity candidates.
    # Plugin identity first (no passphrase prompt needed), then SSH key files.
    local -a id_candidates=()
    if [ -f "$IDENTITY_FILE" ]; then
        if command -v age-plugin-sshagent &>/dev/null; then
            id_candidates+=("$IDENTITY_FILE")
        else
            echo "[mnemon-vault] WARNING: identity file found but age-plugin-sshagent is not in PATH — install it to decrypt via ssh-agent" >&2
        fi
    fi
    for k in ~/.ssh/id_ed25519 ~/.ssh/id_rsa ~/.ssh/id_ed25519_sk; do
        [ -f "$k" ] && id_candidates+=("$k")
    done
    if [ ${#id_candidates[@]} -eq 0 ]; then
        echo "[mnemon-vault] ERROR: no SSH private key found in ~/.ssh (id_ed25519 / id_rsa)" >&2
        exit 1
    fi

    # Import team memories (all devices)
    local team_total=0 team_decrypted=0 team_count=0
    for f in "$SYNC_DIR/data/team/"*.json.age; do
        [ -f "$f" ] || continue
        team_total=$((team_total + 1))
        local tmp
        tmp=$(mktemp /tmp/mnemon-team-XXXXXX.json)
        if _decrypt_with_candidates "$tmp" "$f" "${id_candidates[@]}"; then
            team_decrypted=$((team_decrypted + 1))
            if MNEMON_STORE=team mnemon import "$tmp" > /dev/null 2>&1; then team_count=$((team_count + 1)); fi
        else
            echo "[mnemon-vault] WARNING: could not decrypt $(basename "$f") with your keys" >&2
        fi
        rm -f "$tmp"
    done

    # Import own personal memories only
    local personal_file="$SYNC_DIR/data/personal/insights-${DEVICE}.json.age"
    local personal_count=0
    if [ -f "$personal_file" ]; then
        local tmp
        tmp=$(mktemp /tmp/mnemon-personal-XXXXXX.json)
        if _decrypt_with_candidates "$tmp" "$personal_file" "${id_candidates[@]}"; then
            if MNEMON_STORE=personal mnemon import "$tmp" > /dev/null 2>&1; then personal_count=1; fi
        else
            echo "[mnemon-vault] WARNING: could not decrypt personal file with your keys" >&2
        fi
        rm -f "$tmp"
    fi

    echo "[mnemon-vault] pulled (team: ${team_count} device files, personal: ${personal_count})" >&2

    # Loud actionable warning to STDOUT (not stderr) so SessionStart hook captures it.
    if [ "$team_total" -gt 0 ] && [ "$team_decrypted" -eq 0 ]; then
        echo "[mnemon-vault] WARNING: 0 of ${team_total} team memory files could be decrypted. If your ssh key has a passphrase, run: mnemon-vault setup-agent"
    fi

    # Output routing guide for model to read this session
    [ -f "$SYNC_DIR/guide.md" ] && cat "$SYNC_DIR/guide.md"
}

cmd_status() {
    echo "Sync dir    : $SYNC_DIR"
    echo "Device      : $DEVICE"
    echo "Git host user: ${GIT_HOST_USER:-(not configured)}"
    echo "Git host URL : ${GIT_HOST_URL:-(not configured)}"
    echo ""
    cd "$SYNC_DIR" 2>/dev/null || { echo "(repo not found)"; return; }
    echo "--- Recent commits ---"
    git log --oneline -5 2>/dev/null || echo "(no commits yet)"
    echo ""
    echo "--- Team files ---"
    for f in "$SYNC_DIR/data/team/"*.json.age; do
        if [ -f "$f" ]; then printf "  %s\n" "$(basename "$f")"; fi
    done
    echo "--- Personal files ---"
    for f in "$SYNC_DIR/data/personal/"*.json.age; do
        if [ -f "$f" ]; then printf "  %s\n" "$(basename "$f")"; fi
    done
}

cmd_update() {
    cd "$SYNC_DIR"

    if ! git remote get-url upstream >/dev/null 2>&1; then
        git remote add upstream "$UPSTREAM_URL"
        echo "[mnemon-vault] registered upstream: $UPSTREAM_URL" >&2
    fi

    echo "[mnemon-vault] fetching upstream..." >&2
    git fetch upstream --quiet

    if git diff --quiet upstream/main -- "${TOOLING_FILES[@]}"; then
        echo "[mnemon-vault] already up to date" >&2
        exit 0
    fi

    git checkout upstream/main -- "${TOOLING_FILES[@]}"
    git --no-pager diff --cached --stat -- "${TOOLING_FILES[@]}" >&2
    git commit --quiet -m "chore: update mnemon-vault tooling from upstream" -- "${TOOLING_FILES[@]}"

    if git push origin main --quiet 2>/dev/null; then
        echo "[mnemon-vault] pushed update to team repo — other machines get it on next session" >&2
    else
        echo "[mnemon-vault] WARNING: could not push to origin — run 'git -C $SYNC_DIR push' when online" >&2
    fi

    # Apply Claude Code hook/settings migrations from the NEW install.sh
    bash "$SYNC_DIR/install.sh" --hooks-only || true

    echo "[mnemon-vault] update complete" >&2
    # The checkout above rewrote this running script — exit now so bash
    # never reads stale file offsets past this point.
    exit 0
}

cmd_keygen() {
    _require_age
    echo "age uses your existing SSH keys — no new key needed."
    echo ""
    echo "Your SSH public keys to register on your git host:"
    for k in ~/.ssh/id_ed25519.pub ~/.ssh/id_rsa.pub; do
        [ -f "$k" ] && echo "  $k: $(cat "$k")"
    done
    echo ""
    echo "After adding to your git host, run: mnemon-vault configure"
}

cmd_setup_agent() {
    _require_config

    if ! command -v age-plugin-sshagent &>/dev/null; then
        echo "[mnemon-vault] ERROR: 'age-plugin-sshagent' not found." >&2
        echo "[mnemon-vault] Install: go install github.com/eszio/age-plugin-sshagent@latest" >&2
        echo "[mnemon-vault]   or download from https://github.com/eszio/age-plugin-sshagent/releases" >&2
        exit 1
    fi

    local identity_dir
    identity_dir="$(dirname "$IDENTITY_FILE")"
    mkdir -p "$identity_dir"

    if [ ! -f "$IDENTITY_FILE" ]; then
        age-plugin-sshagent keygen -o "$IDENTITY_FILE" "$@"
    fi

    local recipient
    recipient=$(age-plugin-sshagent recipient -i "$IDENTITY_FILE")

    local recipients_file="$SYNC_DIR/recipients/${GIT_HOST_USER}.txt"
    mkdir -p "$(dirname "$recipients_file")"

    if grep -qxF "$recipient" "$recipients_file" 2>/dev/null; then
        echo "[mnemon-vault] recipient already present in ${recipients_file}"
    else
        echo "$recipient" >> "$recipients_file"
        # recipients/*.txt is gitignored in the public template; force-add to track it in the private repo
        git -C "$SYNC_DIR" add -f "recipients/${GIT_HOST_USER}.txt"
        if git -C "$SYNC_DIR" commit -m "chore(recipients): add sshagent recipient for ${GIT_HOST_USER} (${DEVICE})"; then
            if ! git -C "$SYNC_DIR" push origin main --quiet 2>/dev/null; then
                echo "[mnemon-vault] WARNING: could not push to origin — run 'git -C $SYNC_DIR push' when online" >&2
            fi
        fi
    fi

    echo ""
    echo "Identity file : $IDENTITY_FILE"
    echo "Recipient     : $recipient"
    echo ""
    echo "Teammates' next push will encrypt to this recipient automatically."
    echo "Run 'mnemon-vault pull' to decrypt using your ssh-agent."
}

case "${1:-help}" in
    push)         cmd_push ;;
    pull)         cmd_pull ;;
    status)       cmd_status ;;
    configure)    cmd_configure ;;
    update)       cmd_update ;;
    keygen)       cmd_keygen ;;
    setup-agent)  shift; cmd_setup_agent "$@" ;;
    *)
        echo "Usage: mnemon-vault <command>"
        echo ""
        echo "  configure    — set git host URL and username for this machine (run once)"
        echo "  push         — export memories → encrypt → git push"
        echo "  pull         — git pull → decrypt → import into mnemon"
        echo "  status       — show sync state"
        echo "  update       — pull tooling updates from the public template into your team repo"
        echo "  keygen       — show SSH keys to register on your git host"
        echo "  setup-agent  — use an ssh-agent-derived identity for decryption (requires age-plugin-sshagent)"
        ;;
esac
