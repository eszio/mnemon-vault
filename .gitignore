# Never commit decrypted files
data/**/*.json

# Team roster is private — never ship a real one in the public template.
# Create it from members.txt.example; commit to your PRIVATE repo with: git add -f members.txt
members.txt

# Per-member recipient files are private — never ship real ones in the public template.
# Generated by setup-agent; commit to your PRIVATE repo with: git add -f recipients/<username>.txt
recipients/*.txt

# Per-machine config (not shared)
*.local

# SessionEnd hook log (per-machine)
push.log
